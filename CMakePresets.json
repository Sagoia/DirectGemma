{
    "version": 3,
    "cmakeMinimumRequired": {
      "major": 3,
      "minor": 11,
      "patch": 0
    },
    "configurePresets": [
      {
        "name": "__defaults__",
        "hidden": true,
        "binaryDir": "${sourceDir}/build"
      },
      {
        "name": "make",
        "inherits": "__defaults__",
        "displayName": "Make",
        "description": "Unix Makefiles",
        "generator": "Unix Makefiles",
        "binaryDir": "${sourceDir}/build"
      },
      {
        "name": "windows",
        "inherits": "__defaults__",
        "displayName": "Windows",
        "description": "Visual Studio 2022 with Clang/LLVM frontend",
        "generator": "Visual Studio 17 2022",
        "toolset": "ClangCL",
        "cacheVariables": {
          "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
        },
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        }
      },
      {
        "name": "windows-msvc",
        "inherits": "__defaults__",
        "displayName": "Windows MSVC",
        "description": "Visual Studio 2026 with MSVC frontend",
        "generator": "Visual Studio 18 2026",
        "binaryDir": "${sourceDir}/build-msvc",
        "cacheVariables": {
          "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-vcpkg.cmake",
          "VCPKG_TARGET_TRIPLET": "x64-windows-static-md"
        },
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        }
      },
      {
        "name": "windows-dll",
        "inherits": "__defaults__",
        "displayName": "Windows DLL",
        "description": "Visual Studio 2022 with Clang/LLVM frontend (DLL build)",
        "generator": "Visual Studio 17 2022",
        "toolset": "ClangCL",
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        },
        "cacheVariables": {
          "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
          "BUILD_SHARED_LIBS": "OFF",
          "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
          "BUILD_GEMMA_DLL": "ON"
        }
      },
      {
        "name": "windows-msvc-dll",
        "inherits": "__defaults__",
        "displayName": "Windows MSVC DLL",
        "description": "Visual Studio 2026 with MSVC frontend (DLL build)",
        "generator": "Visual Studio 18 2026",
        "binaryDir": "${sourceDir}/build-msvc",
        "condition": {
          "type": "equals",
          "lhs": "${hostSystemName}",
          "rhs": "Windows"
        },
        "cacheVariables": {
          "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
          "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/windows-vcpkg.cmake",
          "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
          "BUILD_SHARED_LIBS": "OFF",
          "CMAKE_WINDOWS_EXPORT_ALL_SYMBOLS": "ON",
          "BUILD_GEMMA_DLL": "ON"
        }
      }
    ],
    "buildPresets": [
      {
        "name": "__defaults__",
        "hidden": true,
        "targets": [
            "gemma",
            "libgemma"
        ]
      },
      {
        "name": "make",
        "inherits": "__defaults__",
        "displayName": "Unix Makefiles",
        "configurePreset": "make"
      },
      {
        "name": "windows",
        "inherits": "__defaults__",
        "displayName": "Windows",
        "configuration": "Release",
        "configurePreset": "windows"
      },
      {
        "name": "windows-msvc",
        "inherits": "__defaults__",
        "displayName": "Windows MSVC",
        "configuration": "Release",
        "configurePreset": "windows-msvc"
      },
      {
        "name": "windows-dll",
        "displayName": "Windows DLL",
        "configuration": "Release",
        "configurePreset": "windows-dll",
        "targets": [
            "gemma_shared"
        ]
      },
      {
        "name": "windows-msvc-dll",
        "displayName": "Windows MSVC DLL",
        "configuration": "Release",
        "configurePreset": "windows-msvc-dll",
        "targets": [
            "gemma_shared"
        ]
      }
    ]
  }
